{
  "checks": [
    {
      "name": "format",
      "executable": "dotnet",
      "arguments": ["format", "--verify-no-changes"],
      "timeoutSeconds": 600
    },
    {
      "name": "build",
      "executable": "dotnet",
      "arguments": ["build", "--configuration", "Release", "--nologo", "--warnaserror"],
      "timeoutSeconds": 1200
    },
    {
      "name": "tests",
      "executable": "dotnet",
      "arguments": ["test", "--configuration", "Release", "--no-build", "--nologo"],
      "timeoutSeconds": 1800
    }
  ]
}
