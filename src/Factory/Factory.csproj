<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>Factory</AssemblyName>
    <RootNamespace>Factory</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Factory.Tests" />
    <EmbeddedResource Include="ui/index.html" LogicalName="Factory.Ui.Index" />
    <EmbeddedResource Include="ui/app.css" LogicalName="Factory.Ui.Style" />
    <EmbeddedResource Include="ui/app.js" LogicalName="Factory.Ui.Script" />
    <Content Include="Providers/Codex/Assets/**/*">
      <Link>providers/codex/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Override the vulnerable transitive native SQLite bundle (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
